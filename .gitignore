# Crisis Management System - Git Ignore

# Uploads directory (user-generated content)
uploads/*
!uploads/.gitkeep

# Keep the directory structure
!uploads/documents/
uploads/documents/*
!uploads/documents/.gitkeep

!uploads/profiles/
uploads/profiles/*
!uploads/profiles/.gitkeep

# Configuration file with sensitive data (if using custom config)
# includes/config.local.php

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
error.log
access.log

# Temporary files
tmp/
temp/
*.tmp

# Backup files
*.bak
*.backup
backup_*.sql

# PHP cache
.phpunit.cache/

# Session files
sessions/

# Node modules (if any)
node_modules/

# Composer (if any)
vendor/
composer.lock
